# Copy this file to .env and fill in real values.
# .env is git-ignored -- never commit real API keys or credentials.

# --- Database ---
DATABASE_URL=sqlite:///data/processed/medguard.db
# For production, use Postgres instead, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/medguard

# --- Qdrant (vector store) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=fda_label_chunks
# Only needed if using Qdrant Cloud instead of local/Docker:
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6NGU5NTIyNjktMTUxNC00OGE0LTkxYzctNjc5Y2NjYmRiNWM3In0.A_FuqOn3waBp5Y21TyKZ1GPo4C7ZXCxcm8qbiFbx2as

# --- Claude API (generation layer) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# --- openFDA (unstructured label data) ---
# Optional but recommended: register at https://open.fda.gov/apis/authentication
# for a higher rate limit than the anonymous default.
OPENFDA_API_KEY=

# --- App behavior ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=10
RERANK_TOP_N=4
