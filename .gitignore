# Secrets -- never commit real credentials
.env
*.env
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases (generated by ingestion scripts -- reproducible from data/raw + scripts)
data/processed/*.db
data/processed/*.sqlite
!data/processed/medguard.db

# Qdrant's own storage directory -- binary vector database files, fully
# regeneratable by running chunk_labels.py + embed_chunks.py against the
# raw/processed data. Committing this would bloat the repo with large
# binary files that don't diff or merge meaningfully in git.
qdrant_storage/

# Raw data can be large; keep small CSVs but ignore bulk dumps if we add them later
# (uncomment if data/raw grows beyond what's reasonable to commit)
# data/raw/*.json

# OS/editor cruft
.DS_Store
.vscode/
.idea/

# Docker
*.log

# Node (if the Streamlit/frontend layer ever needs it)
node_modules/
